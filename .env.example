# Database
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# WhatsApp Notification (admin phone in international format, e.g. 237XXXXXXXXX)
ADMIN_WHATSAPP_NUMBER="237XXXXXXXXX"

# CallMeBot API Key (get from https://www.callmebot.com/blog/free-api-whatsapp-messages/)
CALLMEBOT_API_KEY="your-callmebot-api-key"
